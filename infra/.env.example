# -----------------------------------------------------------------------------
# Optional overrides for the dev stack. Copy to `.env` (git-ignored) to change.
# Every value has a sane default inside docker-compose.yml.
#
# NOTE: there is no POSTGRES_PASSWORD here on purpose. The database password is
# generated at first start by the `secrets-init` service and lives only in the
# `udapay_secrets` volume and in Vault (kv/udapay-ledger/dev).
# -----------------------------------------------------------------------------

# PostgreSQL
POSTGRES_DB=udapay
POSTGRES_USER=udapay

# Vault (dev mode root token — dev stack only, never use in production)
VAULT_DEV_ROOT_TOKEN_ID=root-token-dev

# Keycloak bootstrap admin (dev stack only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Issuer as seen by token holders (must equal the `iss` claim in the JWT)
KEYCLOAK_ISSUER_URI=http://localhost:9000/realms/udapay
